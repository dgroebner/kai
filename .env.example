# -------------------------------------------------------
# Anwendung
# -------------------------------------------------------

# Basis-URL der Anwendung (ohne abschließenden Slash)
APP_URL=https://deine-domain.de

# -------------------------------------------------------
# Datenbank (MySQL/MariaDB)
# -------------------------------------------------------

DB_HOST=dein-db-host.de
DB_PORT=3306
DB_NAME=dein_datenbankname
DB_USER=dein_db_user
DB_PASS=dein_db_passwort

# -------------------------------------------------------
# Google OAuth (Login)
# -------------------------------------------------------

# OAuth 2.0 Client-ID und Secret aus der Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://deine-domain.de/login.php

# Autorisierte Nutzer (kommagetrennte E-Mail-Adressen)
# Nur diese Adressen dürfen sich einloggen
ALLOWED_USERS=email1@gmail.com,email2@gmail.com

ADMIN_EMAIL=email1@gmail.com

# -------------------------------------------------------
# Google Gemini KI
# -------------------------------------------------------

# API-Key aus Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=dein_gemini_api_key

# Modell-Name (z.B. gemini-2.0-flash-lite, gemini-2.0-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.0-flash-lite

# Aufbewahrungsdauer der Log-Dateien in Tagen (Standard: 14)
LOG_RETENTION_DAYS=14

# Nur für lokale Entwicklung ohne gültiges SSL-Zertifikat auf true setzen
# Niemals in Produktion auf true setzen!
GEMINI_DISABLE_SSL=false

# -------------------------------------------------------
# Comdirect API Keys
# -------------------------------------------------------
COMDIRECT_CLIENT_ID=
COMDIRECT_CLIENT_SECRET=

# Geheimer Systemschlüssel für die Token-Verschlüsselung (AES/Sodium)
BANK_ENCRYPTION_KEY=

# -------------------------------------------------------
# IMAP (E-Mail-Postfach für Kassenbons)
# -------------------------------------------------------

IMAP_HOST=imap.dein-anbieter.de
IMAP_PORT=993
IMAP_USER_KASSENBON=agent@deine-domain.de
IMAP_PASS_KASSENBON=dein_imap_passwort

# Verschlüsselung: ssl oder tls
IMAP_ENCRYPTION=ssl

# Optional: IMAP-Ordner, der auf neue Mails überwacht wird (Standard: INBOX)
# IMAP_INBOX=INBOX

# Optional: Absender-Adressen, von denen Kassenbons akzeptiert werden (kommagetrennt)
# IMAP_ALLOWED_SENDERS=bon@haendler1.de,bon@haendler2.de

# Schlüsselwörter zur Erkennung von Kreditkartenabrechnungen
MAIL_BANK_KEYWORDS=

# -------------------------------------------------------
# Forecast Solar
# -------------------------------------------------------

# API-Key von forecast.solar (https://forecast.solar)
FORECAST_SOLAR_API_KEY=dein_forecast_solar_api_key

# -------------------------------------------------------
# Cron-Job Absicherung
# -------------------------------------------------------

# Geheimer Token zur Absicherung des Cron-Endpunkts
# Erzeuge einen sicheren Wert z.B. mit: php -r "echo bin2hex(random_bytes(16));"
# Aufruf: https://deine-domain.de/kassenbon/cron.php?token=DEIN_TOKEN
CRON_TOKEN=ein-zufaelliger-sicherer-token

# -------------------------------------------------------
# Smart Home & Assistant API (Home Assistant / Google Home)
# -------------------------------------------------------

# Geheimer API-Key für maschinelle Zugriffe via Bearer-Header
# Falls leer, wird als Fallback CRON_TOKEN verwendet.
ASSISTANT_API_KEY=ein-zufaelliger-sicherer-assistant-key

# -------------------------------------------------------
# Web Push (VAPID) Benachrichtigungen
# -------------------------------------------------------

# VAPID-Schlüssel für Web Push Notifications (RFC 8292)
# Erzeuge ein Schlüsselpaar mit:
#   php -r "
#     \$keys = \Minishlink\WebPush\VAPID::createVapidKeys();
#     echo 'VAPID_PUBLIC_KEY='.\$keys['publicKey'].PHP_EOL;
#     echo 'VAPID_PRIVATE_KEY='.\$keys['privateKey'].PHP_EOL;
#   "
# Wichtig: Werte ohne Anführungszeichen eintragen!
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-Mail-Adresse des App-Betreibers (wird im VAPID-Header übermittelt)
VAPID_SUBJECT=mailto:deine@email.de

#-------------------------------------------------------
# d.velop Postbox Konfiguration
# -------------------------------------------------------
DVELOP_POSTBOX_EMAIL=deine_mail@mail.postbox.eu

# -------------------------------------------------------
# Schule (Stundenplan24 & Beste Schule)
# -------------------------------------------------------

# --- Stundenplan24 (Indiware VPPlan24) ---
# Schulnummer bei stundenplan24.de (z. B. 10058903)
# Kann alternativ auch im UI unter Systemverwaltung gepflegt werden
STUNDENPLAN_SCHOOL_NUMBER=10058903

# Zugangsdaten (HTTP Basic Auth) für den Vertretungsplan
STUNDENPLAN_USER=
STUNDENPLAN_PASSWORD=

# --- Beste Schule API ---
# Personal Access Token für die Beste Schule API
# Zu erstellen im Web-Interface unter Profil -> Token erstellen (Lesezugriff)
BESTE_SCHULE_API_TOKEN=

# -------------------------------------------------------
# TRONITY (Fahrzeug-Telemetrie & Livedaten)
# -------------------------------------------------------
# Erstelle eine Client-Anwendung unter https://app.tronity.tech (Entwickler / API)
TRONITY_CLIENT_ID=
TRONITY_CLIENT_SECRET=
# Optional: Spezifische Fahrzeug-ID (wird automatisch ermittelt, falls leer)
TRONITY_VEHICLE_ID=
